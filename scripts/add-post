#!/usr/bin/env python3
"""Add or update a blog post on workshopai.com.au.

Usage:
  scripts/add-post <path/to/blog.md> [--assets <dir>] [--slug <slug>] [--date <yyyy-mm-dd>] [--site <repo root>]
  scripts/add-post --rebuild [--site <repo root>]

Reads blog.md and its images (default: the assets/ folder beside blog.md, which
matches the content engine's pack/blog.md and pack/assets/<slot id>.png|jpg),
writes blog/<slug>/ and _src/blog/<slug>.md, then regenerates every blog page,
blog/index.html, blog/feed.xml and sitemap.xml. Deterministic and safe to re-run
for the same slug. Exits 1 with a message, writing nothing, if the post can't be
published as written. See docs/blog.md.
"""
import argparse
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(REPO, "_src"))

import blog  # noqa: E402
import build  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="scripts/add-post", description="Add or update a blog post.")
    ap.add_argument("blog_md", nargs="?", help="path to blog.md")
    ap.add_argument("--assets", help="folder holding the post's images (default: assets/ beside blog.md)")
    ap.add_argument("--slug", help="override the slug (default: frontmatter slug, then the article folder name)")
    ap.add_argument("--date", help="override the publish date, yyyy-mm-dd (default: frontmatter publish_date or date)")
    ap.add_argument("--site", default=REPO, help="site repo root (default: this repo)")
    ap.add_argument("--rebuild", action="store_true", help="regenerate the blog and sitemap from _src/blog/ only")
    args = ap.parse_args(argv)
    root = os.path.abspath(args.site)

    try:
        if args.rebuild:
            if args.blog_md:
                ap.error("--rebuild takes no blog.md")
            blog.build_all(root)
            build.build_sitemap(root)
            print("rebuilt the blog and sitemap.xml")
            return 0
        if not args.blog_md:
            ap.error("give the path to blog.md, or --rebuild")
        post = blog.add_post(root, args.blog_md, assets_dir=args.assets, slug=args.slug, date=args.date)
    except (blog.BlogError, OSError) as exc:
        print(f"add-post: {exc}", file=sys.stderr)
        return 1
    status = "sample (not listed)" if post["sample"] else "listed"
    print(f"added {blog.BLOG_PATH}{post['slug']}/ ({post['date']}, {status}, "
          f"{len(post['images'])} image{'s' if len(post['images']) != 1 else ''})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
